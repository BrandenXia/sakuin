# Pin a release tag in production. `latest` downloads the newest release bundle.
SAKUIN_VERSION=latest

# Optional comma-separated override. When empty, Sakuin uses the public router
# list packaged at share/sakuin/dht-bootstrap.txt in the release bundle.
SAKUIN_DHT_BOOTSTRAP=

SAKUIN_API_PORT=8080
SAKUIN_DHT_PORT=6881
SAKUIN_ENABLE_IPV6=false

# Optional image and release-source overrides.
SAKUIN_IMAGE=sakuin:local
SAKUIN_RELEASE_BASE_URL=https://github.com/BrandenXia/sakuin/releases
# SAKUIN_BINARY_URL=https://example.invalid/sakuin-linux-amd64.tar.gz

# Named volume containing canonical, derived, and operational state.
SAKUIN_DATA_VOLUME=sakuin-data
